tools/*.zip

# Server specific exclusions (track server configs/scripts/mods/cores/java, ignore heavy world backups & logs)
server/logs/
server/crash-reports/
server/world_backup_*/
server/_backup_*/
server/*.log
!server/*.jar

# Python / temp clutter
__pycache__/
*.pyc
.pytest_cache/
_mod_dl_cache/
_mod_download/
_parked_mods_*/
_backup_*/
_tmp_*/
scratch/
img/
art_source/
extracted_elements_png/
balance-minigame-icons/
casesmod-fixed-source_*/
aquatech-ui/
modlist/
scripts_crafttweaker_archived/

# Parked jars inside mods/
mods/_parked_*/
mods/*.zip
mods/*.rar

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Secrets — never commit!
.gh_token
.cf_token
.cloudflare_token
*.token
secrets.json
node_modules/

# Orphan gitlink (no .gitmodules) — breaks Cloudflare Pages submodule update
tools/Custom-Nameplates/


# Too large for Cloudflare Pages (25 MiB limit); host via GitHub Releases
AquaTechLauncher.exe


tools/_go/
bootstrap/AquaTech.exe


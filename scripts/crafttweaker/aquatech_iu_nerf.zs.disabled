craftingTable.remove(<item:avaritia_armor:crystal_leggings>);
craftingTable.remove(<item:avaritia_armor:crystal_boots>);
craftingTable.remove(<item:avaritia_armor:crystal_core>);

// ===== Flight =====
craftingTable.remove(<item:industrialupgrade:armour/jetpack>);
craftingTable.remove(<item:industrialupgrade:armour/advjetpack>);
craftingTable.remove(<item:industrialupgrade:armour/impjetpack>);

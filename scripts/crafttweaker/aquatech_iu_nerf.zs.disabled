craftingTable.remove(<item:avaritia:infinity_elytra>);
craftingTable.remove(<item:avaritia:infinity_umbrella>);

// ===== Infinite / creative / world-breakers =====
craftingTable.removeByRegex("industrialupgrade:creative_.*");
craftingTable.removeByRegex("ae2:creative_.*");

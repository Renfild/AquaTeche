#priority 90
#reloadable
/*
  AquaTech — deny TP / flight / infinite gens that break ocean-raft survival.
  Industrial Upgrade remains the tech core. Alfheim (world_seed) stays legal.
  IU item IDs must use nested registry paths (see IU jar models).
*/

import crafttweaker.api.item.IItemStack;

// ===== Teleport / long-range mobility =====
craftingTable.remove(<item:industrialupgrade:basemachine3/teleporter_iu>);
craftingTable.remove(<item:industrialupgrade:tools/frequency_transmitter>);

craftingTable.remove(<item:draconicevolution:dislocator>);
craftingTable.remove(<item:draconicevolution:advanced_dislocator>);
craftingTable.remove(<item:draconicevolution:player_dislocator>);
craftingTable.remove(<item:draconicevolution:player_dislocator_unbound>);
craftingTable.remove(<item:draconicevolution:p2p_dislocator>);
craftingTable.remove(<item:draconicevolution:p2p_dislocator_unbound>);
craftingTable.remove(<item:draconicevolution:dislocator_pedestal>);
craftingTable.remove(<item:draconicevolution:dislocator_receptacle>);

craftingTable.remove(<item:botania:flugel_eye>);
craftingTable.remove(<item:botania:lens_warp>);
craftingTable.remove(<item:botania:ender_hand>);
// Alfheim portal (world_seed) intentionally kept

craftingTable.remove(<item:avaritia:endest_pearl>);

craftingTable.remove(<item:ae2:quantum_ring>);
craftingTable.remove(<item:ae2:quantum_link>);
craftingTable.remove(<item:ae2:quantum_entangled_singularity>);
craftingTable.remove(<item:ae2:spatial_io_port>);
craftingTable.remove(<item:ae2:spatial_anchor>);

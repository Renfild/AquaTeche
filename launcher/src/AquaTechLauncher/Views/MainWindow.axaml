<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AquaTechLauncher.ViewModels"
        x:Class="AquaTechLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/aquatech.ico"
        Title="AquaTech"
        Width="980" Height="640"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1218"
        FontFamily="Segoe UI Variable Display, Segoe UI">

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1E27"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>
    <Style Selector="Button.nav:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#1A1E27"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#151922"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CaretBrush" Value="#06B6D4"/>
    </Style>
    <Style Selector="Button.glass">
      <Setter Property="Background" Value="#1A1E27"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.glass:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#222733"/>
    </Style>
    <Style Selector="Button.glass:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.play:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.play:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.auth">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.auth:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.auth:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.play /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.auth /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.glass /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1A1E27"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
  </Window.Styles>

  <Panel>
    <Grid ColumnDefinitions="220,*" IsEnabled="{Binding !NeedsAuth}">
      <Border Background="#12151C" BorderBrush="#1F2430" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,22,18,8" Spacing="2">
            <TextBlock Text="AQUATECH" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="1"/>
            <TextBlock Text="Launcher" FontSize="11" Foreground="#64748B"/>
          </StackPanel>

          <Border DockPanel.Dock="Top" Background="#1A1E27" CornerRadius="10" Margin="14,12,14,16" Padding="12,9">
            <TextBlock Text="AquaTech Ocean" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
          </Border>

          <StackPanel DockPanel.Dock="Top" Margin="10,0" Spacing="4">
            <Button Classes="nav" Content="Игра" Command="{Binding ShowPlayCommand}" Classes.active="{Binding IsPlayPage}"/>
            <Button Classes="nav" Content="Настройки" Command="{Binding ShowSettingsCommand}" Classes.active="{Binding IsSettingsPage}"/>
            <Button Classes="nav" Content="Активность" Command="{Binding ShowLogCommand}" Classes.active="{Binding IsLogPage}"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="18,16" Spacing="4" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding OnlinePlayersText}" FontSize="11" Foreground="#06B6D4"/>
            <TextBlock Text="{Binding VersionLabel}" FontSize="10" Foreground="#64748B"/>
            <TextBlock Text="{Binding McLabel}" FontSize="10" Foreground="#64748B"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel Grid.Column="1" Background="#0F1218" Margin="16">
        <DockPanel IsVisible="{Binding IsPlayPage}">
          <Border DockPanel.Dock="Top" Classes="panel" Height="120" Margin="0,0,0,12" Padding="28,0">
            <TextBlock Text="AQUATECH" FontSize="36" FontWeight="Bold" Foreground="#F8FAFC"
                       LetterSpacing="2" VerticalAlignment="Center"/>
          </Border>

          <ScrollViewer>
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="НИКНЕЙМ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" LetterSpacing="1"/>
                <TextBox Classes="field" Text="{Binding Username}" IsReadOnly="True"/>
              </StackPanel>

              <Border Classes="panel" Padding="18,14">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="AquaTech Ocean" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding ServerStatus}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                      <TextBlock Text="●" FontSize="12" Foreground="{Binding ServerDot}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ServerAddress}" FontSize="13" Foreground="#06B6D4" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="glass" Content="Скопировать IP" Command="{Binding CopyIpCommand}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Button Classes="play" Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}"
                      IsEnabled="{Binding ActionsEnabled}" HorizontalAlignment="Stretch">
                <Button.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#06B6D4" Offset="1"/>
                  </LinearGradientBrush>
                </Button.Background>
              </Button>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#94A3B8"/>
                  <TextBlock Grid.Column="1" Text="{Binding PctText}" FontSize="12" Foreground="#06B6D4"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                             Foreground="#3B82F6" Background="#151922" CornerRadius="3"/>
              </StackPanel>

              <TextBlock Text="При «Играть» сборка обновится сама. После старта окно свернётся."
                         FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <ScrollViewer IsVisible="{Binding IsSettingsPage}">
          <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Память и папка игры." FontSize="12" Foreground="#94A3B8"/>
            <Border Classes="panel" Padding="24,22">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="ОПЕРАТИВКА" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                  <TextBox Classes="field" Text="{Binding RamText}"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="ПАПКА ИГРЫ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                  <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Classes="field" Text="{Binding GameDir}"/>
                    <Button Grid.Column="2" Classes="glass" Content="⋯" Command="{Binding BrowseGameDirCommand}"
                            Width="48" Height="44" Padding="0" HorizontalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <DockPanel IsVisible="{Binding IsLogPage}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="Активность" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Grid.Column="1" Text="лог установки" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom"/>
          </Grid>
          <Border Classes="panel" Padding="6">
            <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,2">
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11"
                               Foreground="{Binding Color}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Panel>
    </Grid>

    <!-- Opaque auth gate -->
    <Border Background="#0B0D12" IsVisible="{Binding NeedsAuth}" ZIndex="100">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" MaxWidth="420" Margin="32">
        <TextBlock Text="AQUATECH" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"
                   HorizontalAlignment="Center" LetterSpacing="2"/>
        <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center"/>
        <TextBlock Text="Вы не авторизованы" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Войди аккаунтом с сайта AquaTech. Регистрация только на сайте."
                   FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Проверяем сессию…" FontSize="12" Foreground="#64748B"
                   HorizontalAlignment="Center" IsVisible="{Binding AuthChecking}"/>

        <Button Classes="auth" Content="Авторизоваться" Command="{Binding BeginAuthCommand}"
                HorizontalAlignment="Stretch" MinWidth="280" IsVisible="{Binding !ShowLoginForm}"
                IsEnabled="{Binding !AuthChecking}">
          <Button.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#3B82F6" Offset="0"/>
              <GradientStop Color="#06B6D4" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
        </Button>

        <StackPanel Spacing="12" IsVisible="{Binding ShowLoginForm}" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="НИК" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBox Classes="field" Text="{Binding LoginNick}" Watermark="никнейм"/>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBox Classes="field" Text="{Binding LoginPassword}" PasswordChar="•" Watermark="пароль"/>
          </StackPanel>
          <TextBlock Text="{Binding AuthError}" FontSize="12" Foreground="#EF4444" TextWrapping="Wrap"
                     MinHeight="18" TextAlignment="Center" HorizontalAlignment="Stretch"/>
          <Button Classes="auth" Content="Войти" Command="{Binding SubmitLoginCommand}"
                  IsEnabled="{Binding !AuthBusy}" HorizontalAlignment="Stretch" MinWidth="280">
            <Button.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#06B6D4" Offset="1"/>
              </LinearGradientBrush>
            </Button.Background>
          </Button>
          <Button Classes="glass" Content="Регистрация на сайте" Command="{Binding OpenRegisterCommand}"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</Window>

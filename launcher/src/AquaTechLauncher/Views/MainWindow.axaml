<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AquaTechLauncher.ViewModels"
        xmlns:core="using:AquaTechLauncher.Core"
        x:Class="AquaTechLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/aquatech.ico"
        Title="AquaTech Launcher"
        Width="1280" Height="760"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#001619"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowSettingsCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CancelLogoutCommand}"/>
  </Window.KeyBindings>

  <Window.Resources>
    <!-- Fluent берёт акцент из этих ключей: чекбоксы, скроллбары, фокус -->
    <Color x:Key="SystemAccentColor">#50E8F4</Color>
    <Color x:Key="SystemAccentColorLight1">#7DF0F8</Color>
    <Color x:Key="SystemAccentColorLight2">#A9F6FB</Color>
    <Color x:Key="SystemAccentColorLight3">#D5FBFC</Color>
    <Color x:Key="SystemAccentColorDark1">#3FCEDF</Color>
    <Color x:Key="SystemAccentColorDark2">#2FA5B8</Color>
    <Color x:Key="SystemAccentColorDark3">#1E7583</Color>

    <!-- текстовые поля: Fluent красит внутренний бордер ресурсами, не Background -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#99001619"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B3001619"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#D9001619"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#4D001619"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24A8DFE9"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#61A8DFE9"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8C50E8F4"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#14001619"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="#CCA8DFE9"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#A8DFE9"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#A8DFE9"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#61A8DFE9"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#6650E8F4"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#61A8DFE9"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#99A8DFE9"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#61A8DFE9"/>
  </Window.Resources>

  <Window.Styles>
    <!-- весь текст по центру; исключения (логи, консоль) переопределяют ниже -->
    <Style Selector="TextBlock">
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- ============ вход приложения ============ -->
    <Style Selector="Border.enter-1">
      <Setter Property="Opacity" Value="0"/>
      <Style.Animations>
        <Animation Duration="0:0:0.45" Delay="0:0:0.02" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.enter-2">
      <Setter Property="Opacity" Value="0"/>
      <Style.Animations>
        <Animation Duration="0:0:0.5" Delay="0:0:0.08" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.enter-3">
      <Setter Property="Opacity" Value="0"/>
      <Style.Animations>
        <Animation Duration="0:0:0.55" Delay="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.enter-4">
      <Setter Property="Opacity" Value="0"/>
      <Style.Animations>
        <Animation Duration="0:0:0.6" Delay="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- дышащее свечение в герое -->
    <Style Selector="Border.hero-glow">
      <Style.Animations>
        <Animation Duration="0:0:8" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.55"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- ============ рельс ============ -->
    <Style Selector="Border.rail-card">
      <Setter Property="Background" Value="#04202A"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.rail-card.light">
      <Setter Property="Background" Value="#92D2DF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#99A8DFE9"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#29A8DFE9"/>
      <Setter Property="Foreground" Value="#A8DFE9"/>
    </Style>
    <Style Selector="Button.nav:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#50E8F4"/>
      <Setter Property="Foreground" Value="#001619"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#50E8F4"/>
      <Setter Property="Foreground" Value="#001619"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#50E8F4"/>
      <Setter Property="Foreground" Value="#001619"/>
    </Style>

    <!-- Material glyphs: Segoe MDL2 Assets ships with Windows 10/11 -->
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#61A8DFE9"/>
    </Style>
    <Style Selector="TextBlock.syne">
      <Setter Property="FontFamily" Value="avares://AquaTechLauncher/Assets/Fonts#Syne"/>
    </Style>

    <!-- ============ кнопки ============ -->
    <Style Selector="Button.play">
      <Setter Property="Background" Value="#50E8F4"/>
      <Setter Property="Foreground" Value="#001619"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="MinWidth" Value="248"/>
      <Setter Property="Padding" Value="26,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7DF0F8"/>
      <Setter Property="Foreground" Value="#001619"/>
    </Style>
    <Style Selector="Button.play:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)"/>
    </Style>
    <Style Selector="Button.play:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#2950E8F4"/>
      <Setter Property="Foreground" Value="#50E8F4"/>
    </Style>
    <Style Selector="Button.play:disabled">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CCA8DFE9"/>
      <Setter Property="BorderBrush" Value="#29A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1450E8F4"/>
      <Setter Property="Foreground" Value="#A8DFE9"/>
      <Setter Property="BorderBrush" Value="#8C50E8F4"/>
    </Style>
    <Style Selector="Button.ghost:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)"/>
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.ram-pill">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#99A8DFE9"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ram-pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1450E8F4"/>
    </Style>
    <Style Selector="Button.ram-pill.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#50E8F4"/>
      <Setter Property="Foreground" Value="#001619"/>
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#50E8F4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#A8DFE9"/>
    </Style>

    <!-- ============ карточки ============ -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#04202A"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="#8C50E8F4"/>
      <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>
    <Style Selector="Border.card.light">
      <Setter Property="Background" Value="#92D2DF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.card.light:pointerover">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="#04202A"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.hero">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- прозрачная кнопка-обёртка вокруг карточек -->
    <Style Selector="Button.plain">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.plain /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.plain:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.plain:pressed">
      <Setter Property="RenderTransform" Value="scale(0.99)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- ============ новости ============ -->
    <Style Selector="Border.news-item">
      <Setter Property="Background" Value="#04202A"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.news-item:pointerover">
      <Setter Property="BorderBrush" Value="#8C50E8F4"/>
      <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>
    <Style Selector="Border.news-item:nth-child(1)">
      <Setter Property="Background" Value="#92D2DF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.news-item:nth-child(1) TextBlock.news-title">
      <Setter Property="Foreground" Value="#001619"/>
      <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style Selector="Border.news-item TextBlock.news-title">
      <Setter Property="FontFamily" Value="avares://AquaTechLauncher/Assets/Fonts#Syne"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#A8DFE9"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.news-item:nth-child(1) TextBlock.news-body">
      <Setter Property="Foreground" Value="#C6001619"/>
    </Style>
    <Style Selector="TextBlock.news-body">
      <Setter Property="Foreground" Value="#99A8DFE9"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.date-chip">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="#2950E8F4"/>
    </Style>
    <Style Selector="Border.date-chip TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#50E8F4"/>
    </Style>
    <Style Selector="Border.news-item:nth-child(1) Border.date-chip">
      <Setter Property="Background" Value="#26001619"/>
    </Style>
    <Style Selector="Border.news-item:nth-child(1) Border.date-chip TextBlock">
      <Setter Property="Foreground" Value="#99001619"/>
    </Style>

    <Style Selector="Rectangle.hero-stripe">
      <Setter Property="Width" Value="3"/>
      <Setter Property="RadiusX" Value="2"/>
      <Setter Property="RadiusY" Value="2"/>
      <Setter Property="Fill" Value="#50E8F4"/>
      <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <!-- ============ поля и консоль ============ -->
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#99001619"/>
      <Setter Property="Foreground" Value="#CCA8DFE9"/>
      <Setter Property="BorderBrush" Value="#24A8DFE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#50E8F4"/>
      <Setter Property="SelectionBrush" Value="#3F50E8F4"/>
    </Style>
    <Style Selector="TextBox.field:focus">
      <Setter Property="BorderBrush" Value="#8C50E8F4"/>
    </Style>
    <Style Selector="TextBox.field:pointerover">
      <Setter Property="BorderBrush" Value="#61A8DFE9"/>
    </Style>

    <Style Selector="TextBlock.console-line">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#CCA8DFE9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#A8DFE9"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#50E8F4"/>
      <Setter Property="Background" Value="#2950E8F4"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="Ellipse.pulse-dot">
      <Style.Animations>
        <Animation Duration="0:0:2.6" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.45"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.skeleton">
      <Setter Property="Height" Value="70"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#29A8DFE9"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.6"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#50E8F4"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- фон: угли + два мягких свечения палитры -->
    <Border Background="#001619"/>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="14%,-8%" GradientOrigin="14%,-8%" RadiusX="58%" RadiusY="52%">
          <GradientStop Color="#2650E8F4" Offset="0"/>
          <GradientStop Color="#0050E8F4" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Border.Background>
        <RadialGradientBrush Center="88%,104%" GradientOrigin="88%,104%" RadiusX="52%" RadiusY="48%">
          <GradientStop Color="#1AA8DFE9" Offset="0"/>
          <GradientStop Color="#00A8DFE9" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <DockPanel>
      <!-- ============ строка приложения ============ -->
      <Border DockPanel.Dock="Top" Height="46" BorderBrush="#24A8DFE9" BorderThickness="0,0,0,1" Padding="16,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/aquatech.ico" Width="20" Height="20" VerticalAlignment="Center"/>
            <TextBlock Classes="syne" Text="AquaTech" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#61A8DFE9" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                      IsVisible="{Binding !NeedsAuth}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold" Foreground="#A8DFE9"
                         HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#3350E8F4" CornerRadius="999" Padding="3" VerticalAlignment="Center">
                  <Image Source="/Assets/coin.png" Width="13" Height="13" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{Binding CoinsText}" FontSize="11" Foreground="#8FD9E6" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <Button Classes="link" Content="Выйти" Command="{Binding RequestLogoutCommand}"
                    IsVisible="{Binding !LogoutConfirmVisible}" AutomationProperties.Name="Выйти"/>
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding LogoutConfirmVisible}"
                        VerticalAlignment="Center">
              <Button Classes="link" Content="Отмена" Command="{Binding CancelLogoutCommand}" IsCancel="True"/>
              <Button Classes="link" Content="Выйти" Command="{Binding ConfirmLogoutCommand}" Foreground="#FF7A90"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ рельс + страницы ============ -->
      <Grid ColumnDefinitions="272,*">
        <Border Grid.Column="0" Background="#02191F" BorderBrush="#24A8DFE9" BorderThickness="0,0,1,0" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <Border Classes="rail-card enter-1" Grid.Row="0" Margin="0,0,0,12">
              <Grid ColumnDefinitions="Auto,*">
                <Panel Width="44" Height="44" VerticalAlignment="Top">
                  <Border Width="44" Height="44" CornerRadius="11" Background="#50E8F4">
                    <TextBlock Text="{Binding UsernameInitial}" FontSize="16" FontWeight="Bold" Foreground="#001619"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Image Source="{Binding AvatarImage}" Width="44" Height="44" Stretch="UniformToFill"
                         ToolTip.Tip="{Binding Username}">
                    <Image.Clip>
                      <RectangleGeometry Rect="0,0,44,44" RadiusX="11" RadiusY="11"/>
                    </Image.Clip>
                  </Image>
                </Panel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="eyebrow" Text="АККАУНТ"/>
                  <TextBlock Classes="syne" Text="{Binding Username}" FontSize="15" FontWeight="Bold"
                             Foreground="#A8DFE9" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0" HorizontalAlignment="Center">
                    <Border Background="#50E8F4" CornerRadius="999" Padding="7,2">
                      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Image Source="/Assets/coin.png" Width="13" Height="13" Stretch="UniformToFill"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CoinsNumber}" FontSize="10" FontWeight="Bold" Foreground="#001619"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AccountBadge}" FontSize="10.5" Foreground="#61A8DFE9"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="4" IsVisible="{Binding !NeedsAuth}">
              <Button Classes="nav" Classes.active="{Binding IsPlayPage}" Command="{Binding ShowPlayCommand}">
                <TextBlock Text="Игра"/>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsNewsPage}" Command="{Binding ShowNewsCommand}">
                <TextBlock Text="Новости"/>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding ShowSettingsCommand}">
                <TextBlock Text="Настройки"/>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsLogPage}" Command="{Binding ShowLogCommand}">
                <TextBlock Text="Логи"/>
              </Button>
            </StackPanel>

            <Button Grid.Row="2" Classes="plain" Margin="0,12,0,0"
                    Command="{Binding ShowNewsCommand}" IsVisible="{Binding LatestNewsVisible}"
                    AutomationProperties.Name="Свежая новость">
              <Border Classes="rail-card light enter-2" Padding="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="СЕЙЧАС НА СЕРВЕРЕ" FontSize="10" FontWeight="Bold" Foreground="#99001619"/>
                  <TextBlock Classes="syne" Text="{Binding LatestNewsTitle}" FontSize="13.5" FontWeight="Bold"
                             Foreground="#001619" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis"/>
                  <TextBlock Text="подробнее во вкладке «Новости»" FontSize="11" Foreground="#A6001619"/>
                </StackPanel>
              </Border>
            </Button>

            <Border Grid.Row="4" Classes="rail-card enter-3" Padding="11,10" Margin="0,0,0,10">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="pulse-dot" Width="8" Height="8" Fill="{Binding ServerDot}"
                           VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ServerStatus}" FontSize="13" FontWeight="Bold" Foreground="#A8DFE9"/>
                </StackPanel>
                <TextBlock Text="{Binding OnlinePlayersText}" FontSize="11" Foreground="#61A8DFE9"/>
              </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Spacing="6" IsVisible="{Binding !NeedsAuth}">
              <TextBlock Text="ВЫДЕЛЕНИЕ ПАМЯТИ" FontSize="10.5" FontWeight="Bold" Foreground="#61A8DFE9"/>
              <UniformGrid Columns="5" Margin="0,0,0,0">
                <Button Classes="ram-pill" Classes.selected="{Binding IsRam4096}" Content="4"
                        Command="{Binding SetRamCommand}" CommandParameter="4096" Margin="0,0,3,0"/>
                <Button Classes="ram-pill" Classes.selected="{Binding IsRam6144}" Content="6"
                        Command="{Binding SetRamCommand}" CommandParameter="6144" Margin="0,0,3,0"/>
                <Button Classes="ram-pill" Classes.selected="{Binding IsRam8192}" Content="8"
                        Command="{Binding SetRamCommand}" CommandParameter="8192" Margin="0,0,3,0"
                        ToolTip.Tip="Рекомендуется для индустриальных модов"/>
                <Button Classes="ram-pill" Classes.selected="{Binding IsRam12288}" Content="12"
                        Command="{Binding SetRamCommand}" CommandParameter="12288" Margin="0,0,3,0"/>
                <Button Classes="ram-pill" Classes.selected="{Binding IsRam16384}" Content="16"
                        Command="{Binding SetRamCommand}" CommandParameter="16384"/>
              </UniformGrid>
            </StackPanel>
          </Grid>
        </Border>

        <Panel Grid.Column="1" Margin="20,18,20,20" x:Name="PagesHost">
          <!-- ============ ИГРА ============ -->
          <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsPlayPage}">
            <Border Grid.Row="0" Classes="hero">
              <Panel>
                <Border CornerRadius="20" IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#06303C" Offset="0"/>
                      <GradientStop Color="#04202A" Offset="0.46"/>
                      <GradientStop Color="#001619" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border Classes="hero-glow" CornerRadius="20" IsHitTestVisible="False" Margin="-60,-60,-60,0">
                  <Border.Background>
                    <RadialGradientBrush Center="74%,10%" GradientOrigin="74%,10%" RadiusX="46%" RadiusY="52%">
                      <GradientStop Color="#4D50E8F4" Offset="0"/>
                      <GradientStop Color="#0050E8F4" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel Spacing="14" VerticalAlignment="Bottom" Margin="26,24">
                  <TextBlock Text="ОКЕАНСКИЙ SKYBLOCK" FontSize="11" FontWeight="Bold" Foreground="#50E8F4"/>
                  <TextBlock Classes="syne" Text="AquaTech" FontSize="42" FontWeight="Bold" Foreground="#A8DFE9"
                             LineHeight="44"/>
                  <TextBlock MaxWidth="520" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#99A8DFE9"
                             Text="Плот посреди океана, ни одной шахты: руду вылавливают удочками, заводы работают сами, а кейсы и турниры ждут в меню F4."/>
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding PackMeta}" FontSize="11.5" FontWeight="Bold"
                                 Foreground="#61A8DFE9" VerticalAlignment="Center"/>
                      <TextBlock Text="·" FontSize="11.5" Foreground="#61A8DFE9" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding ServerStatus}" FontSize="11.5" FontWeight="Bold"
                                 Foreground="{Binding ServerDot}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                      <Button Classes="ghost" Command="{Binding OpenGameFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="icon" Text="&#xE838;"/>
                          <TextBlock Text="Папка игры"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost" Command="{Binding RepairPackCommand}" IsEnabled="{Binding ActionsEnabled}"
                              ToolTip.Tip="Проверить целостность и скачать обновления сборки">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="icon" Text="&#xE72C;"/>
                          <TextBlock Text="Обновить сборку"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="play" Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}"
                              IsEnabled="{Binding ActionsEnabled}"
                              ToolTip.Tip="Проверит сборку и запустит клиент"/>
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#99A8DFE9" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding PctText}" FontSize="12" FontWeight="Bold" Foreground="#50E8F4"/>
                    </Grid>
                    <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 Height="5" Margin="0,6,0,0"
                                 AutomationProperties.Name="Прогресс загрузки"
                                 AutomationProperties.HelpText="{Binding StatusText}"/>
                  </Grid>
                </StackPanel>
              </Panel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
              <Border Classes="stat enter-3" Margin="0,0,12,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="syne" Text="{Binding OnlineCountLabel}" FontSize="20" FontWeight="Bold"
                             Foreground="{Binding ServerDot}"/>
                  <TextBlock Text="игроков онлайн" FontSize="11" Foreground="#61A8DFE9"/>
                </StackPanel>
              </Border>
              <Border Classes="stat enter-3" Margin="0,0,12,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="syne" Text="{Binding ServerStatus}" FontSize="20" FontWeight="Bold"
                             Foreground="{Binding ServerDot}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="состояние сервера" FontSize="11" Foreground="#61A8DFE9"/>
                </StackPanel>
              </Border>
              <Border Classes="stat enter-4" Margin="0,0,12,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="syne" Text="{Binding PackVersion}" FontSize="20" FontWeight="Bold"
                             Foreground="#50E8F4"/>
                  <TextBlock Text="версия сборки" FontSize="11" Foreground="#61A8DFE9"/>
                </StackPanel>
              </Border>
              <Border Classes="stat enter-4">
                <StackPanel Spacing="2">
                  <TextBlock Classes="syne" Text="{Binding RamLabel}" FontSize="20" FontWeight="Bold"
                             Foreground="#50E8F4"/>
                  <TextBlock Text="память для Java" FontSize="11" Foreground="#61A8DFE9"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Grid.Row="2" ColumnDefinitions="1.3*,14,*">
              <Button Grid.Column="0" Classes="plain" Command="{Binding ShowNewsCommand}">
                <Border Classes="card light enter-4" Background="#93CCD9">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="НОВОЕ НА СЕРВЕРЕ" Foreground="#99001619"/>
                    <TextBlock Classes="syne" Text="{Binding LatestNewsTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="#001619" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                               IsVisible="{Binding LatestNewsVisible}"/>
                    <TextBlock Classes="syne" Text="Обновления AquaTech" FontSize="17" FontWeight="Bold"
                               Foreground="#001619" IsVisible="{Binding !LatestNewsVisible}"/>
                    <TextBlock Text="Нажми, чтобы открыть все новости сервера" FontSize="12" Foreground="#A6001619"/>
                  </StackPanel>
                </Border>
              </Button>
              <Border Grid.Column="2" Classes="card enter-4">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Text="ПОСЛЕ ЗАПУСКА"/>
                  <TextBlock Classes="syne" Text="Быстрый старт" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"/>
                  <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="#99A8DFE9"
                             Text="Стартовый набор лежит в меню F4 → Киты: бамбуковая удочка, снасти и лестницы. Там же профиль, магазин, кейсы и топы."/>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" HorizontalAlignment="Center">
                    <Button Classes="ghost" Content="Сайт" Command="{Binding OpenWebsiteCommand}" Height="34"
                            AutomationProperties.Name="Сайт проекта"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- ============ НОВОСТИ ============ -->
          <DockPanel IsVisible="{Binding IsNewsPage}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
              <StackPanel Spacing="3">
                <TextBlock Classes="syne" Text="Новости сервера" FontSize="24" FontWeight="Bold" Foreground="#A8DFE9"/>
                <TextBlock Text="Что происходит в океане" FontSize="12" Foreground="#61A8DFE9"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshNewsCommand}"
                      IsEnabled="{Binding !NewsLoading}" MinHeight="34" Padding="14,0"
                      AutomationProperties.Name="Обновить новости">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE72C;"/>
                  <TextBlock Text="Обновить"/>
                </StackPanel>
              </Button>
            </Grid>
            <ScrollViewer>
              <StackPanel>
                <StackPanel IsVisible="{Binding NewsLoading}">
                  <Border Classes="skeleton"/>
                  <Border Classes="skeleton"/>
                  <Border Classes="skeleton"/>
                  <Border Classes="skeleton"/>
                </StackPanel>
                <Border Classes="card" Padding="24,22" IsVisible="{Binding NewsEmpty}">
                  <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Classes="icon" Text="&#xE900;" FontSize="26" Foreground="#61A8DFE9"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Пока нет новостей" FontSize="15" FontWeight="SemiBold" Foreground="#A8DFE9"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Объявления сервера появятся здесь" FontSize="12" Foreground="#61A8DFE9"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding News}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:NewsItem">
                      <Border Classes="news-item">
                        <Grid ColumnDefinitions="Auto,*">
                          <Rectangle Classes="hero-stripe"/>
                          <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <Border Classes="date-chip">
                                <TextBlock Text="{Binding DateLabel}"/>
                              </Border>
                              <TextBlock Classes="news-title" Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Classes="news-body" Text="{Binding Body}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- ============ НАСТРОЙКИ ============ -->
          <ScrollViewer IsVisible="{Binding IsSettingsPage}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Classes="syne" Text="Настройки" FontSize="24" FontWeight="Bold" Foreground="#A8DFE9"/>
                <TextBlock Text="Память, папка сборки и интеграции" FontSize="12" Foreground="#61A8DFE9"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,14,*">
                <Border Grid.Column="0" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="syne" Text="Память и Java" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"/>
                    <StackPanel Spacing="8">
                      <TextBlock Text="Выделение памяти для Minecraft" FontSize="12" FontWeight="SemiBold"
                                 Foreground="#99A8DFE9"/>
                      <TextBox Classes="field" Text="{Binding RamText}" AutomationProperties.Name="Память"/>
                      <UniformGrid Columns="5">
                        <Button Classes="ram-pill" Classes.selected="{Binding IsRam4096}" Content="4 ГБ"
                                Command="{Binding SetRamCommand}" CommandParameter="4096" Margin="0,0,5,0"/>
                        <Button Classes="ram-pill" Classes.selected="{Binding IsRam6144}" Content="6 ГБ"
                                Command="{Binding SetRamCommand}" CommandParameter="6144" Margin="0,0,5,0"/>
                        <Button Classes="ram-pill" Classes.selected="{Binding IsRam8192}" Content="8 ГБ"
                                Command="{Binding SetRamCommand}" CommandParameter="8192" Margin="0,0,5,0"
                                ToolTip.Tip="Рекомендуется для индустриальных модов"/>
                        <Button Classes="ram-pill" Classes.selected="{Binding IsRam12288}" Content="12 ГБ"
                                Command="{Binding SetRamCommand}" CommandParameter="12288" Margin="0,0,5,0"/>
                        <Button Classes="ram-pill" Classes.selected="{Binding IsRam16384}" Content="16 ГБ"
                                Command="{Binding SetRamCommand}" CommandParameter="16384"/>
                      </UniformGrid>
                      <TextBlock Text="Для стабильных 60+ FPS с индустрией обычно хватает 6–8 ГБ." FontSize="11.5"
                                 TextWrapping="Wrap" Foreground="#61A8DFE9"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="syne" Text="Папка игры" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"/>
                    <TextBlock Text="Куда лаунчер ставит сборку" FontSize="12" FontWeight="SemiBold" Foreground="#99A8DFE9"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                      <TextBox Classes="field" Text="{Binding GameDir}" AutomationProperties.Name="Папка игры"/>
                      <Button Grid.Column="2" Classes="ghost" Content="Обзор…" Command="{Binding BrowseGameDirCommand}"
                              Height="40" AutomationProperties.Name="Выбрать папку игры"/>
                    </Grid>
                    <TextBlock Text="{Binding McLabel}" FontSize="11.5" Foreground="#61A8DFE9" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,14,*">
                <Border Grid.Column="0" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="syne" Text="Поведение" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"/>
                    <CheckBox IsChecked="{Binding DiscordRpcEnabled}" Content="Discord Rich Presence"
                              ToolTip.Tip="Показывает в Discord, что ты играешь на AquaTech"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="syne" Text="Сборка" FontSize="15" FontWeight="Bold" Foreground="#A8DFE9"/>
                    <TextBlock Text="Если клиент падает или не коннектится, проверь файлы и убери лишнее." FontSize="12"
                               TextWrapping="Wrap" Foreground="#61A8DFE9"/>
                    <WrapPanel Orientation="Horizontal">
                      <Button Classes="ghost" Content="Починить сборку" Command="{Binding RepairPackCommand}"
                              Margin="0,0,8,8"/>
                      <Button Classes="ghost" Content="Папка игры" Command="{Binding OpenGameFolderCommand}"
                              Margin="0,0,8,8"/>
                      <Button Classes="ghost" Content="Логи" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ ЛОГИ ============ -->
          <DockPanel IsVisible="{Binding IsLogPage}">
            <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
              <TextBlock Classes="syne" Text="Логи" FontSize="24" FontWeight="Bold" Foreground="#A8DFE9"/>
              <TextBlock Text="Что делает лаунчер прямо сейчас" FontSize="12" Foreground="#61A8DFE9"/>
            </StackPanel>
            <Border Classes="card" Padding="8" CornerRadius="16">
              <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogLine">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,2">
                      <TextBlock Text="{Binding Time}" Classes="console-line" Foreground="#61A8DFE9"/>
                      <TextBlock Text="{Binding Text}" Classes="console-line" Foreground="{Binding Color}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>
        </Panel>
      </Grid>
    </DockPanel>

    <!-- ============ вход ============ -->
    <Border IsVisible="{Binding NeedsAuth}" ZIndex="100" Background="#CC000D10">
      <Border Classes="card" Width="404" Padding="28,24" CornerRadius="20"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <Image Source="/Assets/aquatech.ico" Width="40" Height="40" HorizontalAlignment="Center"/>
            <TextBlock Classes="syne" Text="AquaTech" FontSize="22" FontWeight="Bold" Foreground="#A8DFE9"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Океанский skyblock · вход по нику с сервера" FontSize="12.5" Foreground="#61A8DFE9"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Проверяем сессию…" FontSize="13" Foreground="#61A8DFE9" HorizontalAlignment="Center"
                     IsVisible="{Binding AuthChecking}"/>
          <StackPanel Spacing="12" IsEnabled="{Binding CanEditAuth}">
            <StackPanel Spacing="6">
              <TextBlock Text="Ник" FontSize="12" FontWeight="SemiBold" Foreground="#99A8DFE9"/>
              <TextBox x:Name="LoginNickBox" Classes="field" Text="{Binding LoginNick}" Watermark="Ник на сервере"
                       AutomationProperties.Name="Ник" LostFocus="LoginNick_LostFocus">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SubmitLoginCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#99A8DFE9"/>
              <TextBox Classes="field" Text="{Binding LoginPassword}" PasswordChar="*" Watermark="Пароль"
                       AutomationProperties.Name="Пароль">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SubmitLoginCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
            <CheckBox IsChecked="{Binding RememberMe}" Content="Запомнить меня"/>
            <Border Background="#26FF7A90" BorderBrush="#FF7A90" BorderThickness="1" CornerRadius="10" Padding="12,8"
                    IsVisible="{Binding AuthError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding AuthError}" FontSize="13" Foreground="#FF7A90" TextWrapping="Wrap"/>
            </Border>
            <Button Classes="play" Content="{Binding LoginButtonText}" Command="{Binding SubmitLoginCommand}"
                    IsEnabled="{Binding CanEditAuth}" IsDefault="True" Height="46" MinWidth="0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Войти"/>
            <Button Classes="ghost" Content="Войти через браузер" Command="{Binding LoginViaBrowserCommand}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="Откроет aquateche.store: войди на сайте, и лаунчер подхватит сессию сам"/>
            <TextBlock Text="Ждём вход в браузере…" FontSize="12" Foreground="#50E8F4" HorizontalAlignment="Center"
                       IsVisible="{Binding BrowserLoginWaiting}"/>
            <Button Classes="link" Content="Создать аккаунт на aquateche.store" Command="{Binding OpenRegisterCommand}"
                    HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>

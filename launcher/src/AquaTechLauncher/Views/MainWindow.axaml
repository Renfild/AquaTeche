<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AquaTechLauncher.ViewModels"
        x:Class="AquaTechLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/aquatech.ico"
        Title="AquaTech Launcher"
        Width="1020" Height="660"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px) scale(1)"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#151B26"/>
      <Setter Property="Foreground" Value="#F1F5F9"/>
    </Style>
    <Style Selector="Button.nav:pressed">
      <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#151B26"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#121722"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#222C3D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="#06B6D4"/>
    </Style>

    <Style Selector="Button.ram-pill">
      <Setter Property="Background" Value="#121722"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderBrush" Value="#222C3D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ram-pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
    </Style>

    <Style Selector="Button.glass">
      <Setter Property="Background" Value="#151B26"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="BorderBrush" Value="#222C3D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.glass:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-1px) scale(1)"/>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="BorderBrush" Value="#38BDF8"/>
    </Style>
    <Style Selector="Button.glass:pressed">
      <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)"/>
    </Style>

    <Style Selector="Button.play">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Height" Value="54"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.play:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.01)"/>
    </Style>
    <Style Selector="Button.play:pressed">
      <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)"/>
    </Style>

    <Style Selector="Button.auth-action">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.auth-action:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.01)"/>
    </Style>
    <Style Selector="Button.auth-action:pressed">
      <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#101520"/>
      <Setter Property="BorderBrush" Value="#1E2738"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- 1. FULL-SCREEN AUTHENTICATION GATE (Visible when NeedsAuth is TRUE)        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Border Background="#080C14" IsVisible="{Binding NeedsAuth}" ZIndex="100">
      <Panel>
        <!-- Background Ambient Ocean Glow -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Height="600" CornerRadius="300" Opacity="0.15">
          <Border.Background>
            <RadialGradientBrush>
              <GradientStop Color="#0284C7" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>

        <!-- Centered Login Card -->
        <Border Classes="panel" Width="460" Padding="36" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0F1420">
          <StackPanel Spacing="20">
            <!-- Header Brand -->
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <Border Background="#0284C7" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="🌊" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="AQUATECH" FontSize="28" FontWeight="ExtraBold" Foreground="#F8FAFC"
                         LetterSpacing="2" HorizontalAlignment="Center"/>
              <TextBlock Text="Minecraft 1.20.1 · Океанский Skyblock" FontSize="12" Foreground="#38BDF8"
                         HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Height="1" Background="#1E2738" Margin="0,4"/>

            <!-- Form -->
            <StackPanel Spacing="14">
              <TextBlock Text="ВХОД В АККАУНТ" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>

              <StackPanel Spacing="6">
                <TextBlock Text="НИКНЕЙМ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1"/>
                <TextBox Classes="field" Text="{Binding LoginNick}" Watermark="Твой никнейм на сервере"/>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1"/>
                <TextBox Classes="field" Text="{Binding LoginPassword}" PasswordChar="•" Watermark="Пароль от аккаунта"/>
              </StackPanel>

              <CheckBox IsChecked="{Binding RememberMe}" Content="Запомнить меня" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,2"/>

              <!-- Error Alert -->
              <Border Background="#2A1215" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8"
                      IsVisible="{Binding AuthError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding AuthError}" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
              </Border>

              <!-- Submit Button -->
              <Button Classes="auth-action" Content="Войти в аккаунт" Command="{Binding SubmitLoginCommand}"
                      IsEnabled="{Binding !AuthBusy}">
                <Button.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#00F2FE" Offset="0"/>
                    <GradientStop Color="#0284C7" Offset="1"/>
                  </LinearGradientBrush>
                </Button.Background>
              </Button>

              <!-- Register Link -->
              <Button Classes="glass" Content="Создать аккаунт на aquateche.store →" Command="{Binding OpenRegisterCommand}"
                      HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Bottom Status -->
            <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,0">
              <TextBlock Text="{Binding OnlinePlayersText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding VersionLabel}" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- 2. MAIN LAUNCHER INTERFACE (Visible when NeedsAuth is FALSE)                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Grid ColumnDefinitions="240,*" IsVisible="{Binding !NeedsAuth}">
      <!-- Sidebar -->
      <Border Background="#0C1018" BorderBrush="#1A2230" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- Brand Header -->
          <StackPanel DockPanel.Dock="Top" Margin="20,24,20,12" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="#0284C7" CornerRadius="8" Width="32" Height="32">
                <TextBlock Text="🌊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AQUATECH" FontSize="18" FontWeight="ExtraBold" Foreground="#F8FAFC" LetterSpacing="1"/>
                <TextBlock Text="Ocean Skyblock" FontSize="11" Foreground="#38BDF8"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Navigation -->
          <StackPanel DockPanel.Dock="Top" Margin="12,12" Spacing="6">
            <Button Classes="nav" Content="🎮  Игра" Command="{Binding ShowPlayCommand}" Classes.active="{Binding IsPlayPage}"/>
            <Button Classes="nav" Content="⚙️  Настройки" Command="{Binding ShowSettingsCommand}" Classes.active="{Binding IsSettingsPage}"/>
            <Button Classes="nav" Content="📋  Журнал" Command="{Binding ShowLogCommand}" Classes.active="{Binding IsLogPage}"/>
          </StackPanel>

          <!-- Bottom Profile Card & Logout -->
          <StackPanel DockPanel.Dock="Bottom" Margin="16,16" Spacing="10" VerticalAlignment="Bottom">
            <Border Classes="panel" Padding="14,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="6,2">
                    <TextBlock Text="{Binding AccountBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Баланс:" FontSize="11" Foreground="#94A3B8"/>
                  <TextBlock Grid.Column="1" Text="{Binding CoinsText}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                </Grid>
                <Button Classes="glass" Content="Выйти из аккаунта" Command="{Binding LogoutCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="11"/>
              </StackPanel>
            </Border>

            <StackPanel Spacing="2">
              <TextBlock Text="{Binding OnlinePlayersText}" FontSize="11" Foreground="#38BDF8"/>
              <TextBlock Text="{Binding VersionLabel}" FontSize="10" Foreground="#64748B"/>
              <TextBlock Text="{Binding McLabel}" FontSize="10" Foreground="#64748B"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Main Content Area -->
      <Panel Grid.Column="1" Background="#0B0E14" Margin="24">
        <!-- 1. Play Page -->
        <DockPanel IsVisible="{Binding IsPlayPage}">
          <!-- Hero Banner -->
          <Border DockPanel.Dock="Top" Classes="panel" Height="130" Margin="0,0,0,16" Padding="28,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#082F49" Offset="0.6"/>
                <GradientStop Color="#0284C7" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="AQUATECH OCEAN" FontSize="26" FontWeight="ExtraBold" Foreground="#F8FAFC" LetterSpacing="1.5"/>
                <TextBlock Text="Спавн на плоту · Удочки StarCatcher · 12 кейсов · Индустрия" FontSize="13" Foreground="#93C5FD"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="glass" Content="Сайт проекта →" Command="{Binding OpenWebsiteCommand}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ScrollViewer>
            <StackPanel Spacing="16">
              <!-- Welcome Profile Chip -->
              <Border Classes="panel" Padding="18,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Background="#0284C7" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Игрок:" FontSize="12" Foreground="#94A3B8"/>
                      <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock Text="Аккаунт верифицирован и готов к игре" FontSize="11" Foreground="#38BDF8"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CoinsText}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24"/>
                  </Border>
                </Grid>
              </Border>

              <!-- Server Card -->
              <Border Classes="panel" Padding="20,16">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="●" FontSize="14" Foreground="{Binding ServerDot}" VerticalAlignment="Center"/>
                      <TextBlock Text="Основной сервер AquaTech" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ServerStatus}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ServerAddress}" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="glass" Content="📋 Скопировать IP" Command="{Binding CopyIpCommand}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Action Buttons Row (Play + Update) -->
              <Grid ColumnDefinitions="*,12,Auto">
                <Button Grid.Column="0" Classes="play" Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}"
                        IsEnabled="{Binding ActionsEnabled}" HorizontalAlignment="Stretch">
                  <Button.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#00F2FE" Offset="0"/>
                      <GradientStop Color="#4FACFE" Offset="0.5"/>
                      <GradientStop Color="#0284C7" Offset="1"/>
                    </LinearGradientBrush>
                  </Button.Background>
                </Button>
                <Button Grid.Column="2" Classes="glass" Content="🔄 Обновить" Command="{Binding RepairPackCommand}"
                        IsEnabled="{Binding ActionsEnabled}" Height="54" Padding="18,0" FontSize="15"
                        ToolTip.Tip="Проверить целостность и скачать обновления сборки"/>
              </Grid>

              <!-- Progress & Status -->
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#CBD5E1"/>
                  <TextBlock Grid.Column="1" Text="{Binding PctText}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8"
                             Foreground="#38BDF8" Background="#151B26" CornerRadius="4"/>
              </StackPanel>

              <TextBlock Text="При нажатии «Играть» сборка автоматически проверит хеши и скачает обновления."
                         FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- 2. Settings Page -->
        <ScrollViewer IsVisible="{Binding IsSettingsPage}">
          <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
              <TextBlock Text="Параметры запуска" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
              <TextBlock Text="Выделение оперативной памяти и выбор директории сборки." FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>

            <Border Classes="panel" Padding="24,20">
              <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="ВЫДЕЛЕНИЕ ОПЕРАТИВНОЙ ПАМЯТИ (RAM)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1"/>
                  <TextBox Classes="field" Text="{Binding RamText}"/>
                  <!-- Quick RAM Presets -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Classes="ram-pill" Content="4096 MB (4G)" Command="{Binding SetRamCommand}" CommandParameter="4096"/>
                    <Button Classes="ram-pill" Content="6144 MB (6G)" Command="{Binding SetRamCommand}" CommandParameter="6144"/>
                    <Button Classes="ram-pill" Content="8192 MB (8G) ⭐" Command="{Binding SetRamCommand}" CommandParameter="8192"/>
                    <Button Classes="ram-pill" Content="12288 MB (12G)" Command="{Binding SetRamCommand}" CommandParameter="12288"/>
                    <Button Classes="ram-pill" Content="16384 MB (16G)" Command="{Binding SetRamCommand}" CommandParameter="16384"/>
                  </StackPanel>
                  <TextBlock Text="Рекомендуется от 6144 до 8192 MB для стабильных 60+ FPS с индустриальными модами." FontSize="11" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="ДИРЕКТОРИЯ ИГРЫ (.minecraft / AquaTech)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1"/>
                  <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Classes="field" Text="{Binding GameDir}"/>
                    <Button Grid.Column="2" Classes="glass" Content="Обзор 📁" Command="{Binding BrowseGameDirCommand}"
                            Height="44" Padding="14,0" HorizontalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>

                <Border Height="1" Background="#1E2738" Margin="0,4"/>

                <StackPanel Spacing="10">
                  <TextBlock Text="ОБСЛУЖИВАНИЕ И ВОССТАНОВЛЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="1"/>
                  <TextBlock Text="Если возникают ошибки подключения или краши модов, нажми кнопку ниже для полной проверки и авто-очистки лишних файлов."
                             FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                  <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Classes="glass" Content="🔄 Проверить и починить сборку" Command="{Binding RepairPackCommand}"
                            Margin="0,0,10,8" Padding="16,10" Foreground="#38BDF8"/>
                    <Button Classes="glass" Content="📂 Открыть папку игры" Command="{Binding OpenGameFolderCommand}"
                            Margin="0,0,10,8" Padding="14,10"/>
                    <Button Classes="glass" Content="📄 Открыть логи" Command="{Binding OpenLogsFolderCommand}"
                            Margin="0,0,10,8" Padding="14,10"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. Log Page -->
        <DockPanel IsVisible="{Binding IsLogPage}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="Журнал активности" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Grid.Column="1" Text="Лог загрузки и старта игры" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom"/>
          </Grid>
          <Border Classes="panel" Padding="8">
            <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,2">
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Text}" FontFamily="Consolas, monospace" FontSize="11"
                               Foreground="{Binding Color}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Panel>
    </Grid>
  </Panel>
</Window>

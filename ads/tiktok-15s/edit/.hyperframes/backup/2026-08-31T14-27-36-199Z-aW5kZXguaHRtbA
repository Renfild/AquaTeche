        font-family: "Manrope";
        src: url("fonts/manrope-cyrillic-800.woff2") format("woff2");
        font-weight: 800;
        font-style: normal;
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      @font-face {
        font-family: "Manrope";
        src: url("fonts/manrope-latin-800.woff2") format("woff2");
